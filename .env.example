# ==============================================================================
# CHIHIRO BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilainya.
# ==============================================================================

# --- VARIABEL WAJIB ---
# Token autentikasi bot Discord dari Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# ID Voice Channel pemicu pembuatan room Gaming Lounge ("Create Gaming")
CREATE_VC_ID=123456789012345678

# --- VARIABEL OPSIONAL (NILAI DEFAULT OTOMATIS DIGUNAKAN JIKA TIDAK DIISI) ---
# Teks custom activity / status bot saat online
BOT_STATUS_TEXT="🎀 ୨୧ lovely moments with Chihiro ♡"

# Pesan balasan saat bot di-mention langsung di server
MENTION_REPLY_TEXT="🎀 Ehh~ Chihiro dipanggil nih! Ada apa, sayang? ♡"

# Ikon status bot musik pada embed /musicbot (bebas / tidak ada di voice)
MUSIC_ICON_FREE="✅"

# Ikon status bot musik pada embed /musicbot (sibuk / sedang di voice channel)
MUSIC_ICON_BUSY="❌"

# Jumlah channel terbanyak yang ditampilkan pada leaderboard /topvoice
TOP_VOICE_COUNT=10

# Interval pembaruan pesan embed leaderboard /topvoice secara otomatis (milidetik, default: 300000 = 5 menit)
TOP_VOICE_REFRESH_MS=300000

# Interval penghitungan & penyimpanan durasi sesi voice channel (milidetik, default: 60000 = 1 menit)
VOICE_TICK_MS=60000

# Jeda waktu sebelum menghapus room temporary Gaming Lounge yang kosong (milidetik, default: 60000 = 1 menit)
EMPTY_ROOM_DELAY_MS=60000

# Jeda debounce pembaruan embed bot musik saat terjadi rentetan perubahan voice/role (milidetik, default: 2000 = 2 detik)
MUSIC_DEBOUNCE_MS=2000
